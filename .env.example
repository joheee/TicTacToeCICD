# Copy to .env for local use. Never commit the real .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tictactoe

# Compose builds DATABASE_URL from the values above. For `npm run dev` on the host, put this
# line in .env.local (same user/password/db as above, host port = DB_PORT).
# DATABASE_URL=postgres://app:change-me@localhost:5433/tictactoe

# Image tag to run. Locally "dev"; on EC2 the deploy sets this to the git SHA.
IMAGE_TAG=dev
# Full image repo. Locally the compose file builds it; on EC2 this is the ECR repo URI.
IMAGE_REPO=tictactoe-app

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Host port the app is published on.
APP_PORT=3000

# Host port Postgres is published on (127.0.0.1 only). 5432 is often taken.
DB_PORT=5433
